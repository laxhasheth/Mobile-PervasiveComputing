<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etMovieTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Movie Title"
            android:inputType="text" />

        <EditText
            android:id="@+id/etMoviePoster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Poster URL"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/etPlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plot"
            android:inputType="textMultiLine" />

        <EditText
            android:id="@+id/etImdbRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="IMDB Rating"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/etLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Language"
            android:inputType="text" />

        <EditText
            android:id="@+id/etMetascore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Metascore"
            android:inputType="number" />

        <EditText
            android:id="@+id/etReleased"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Released Date"
            android:inputType="text" />

        <EditText
            android:id="@+id/etRated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rated"
            android:inputType="text" />

        <EditText
            android:id="@+id/etRuntime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Runtime"
            android:inputType="text" />

        <EditText
            android:id="@+id/etWriter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Writer"
            android:inputType="text" />

        <EditText
            android:id="@+id/etYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Year"
            android:inputType="number" />

        <EditText
            android:id="@+id/etProduction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Production"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSaveMovie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Movie"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
